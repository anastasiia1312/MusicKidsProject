rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar autenticación
    function isSignedIn() {
      return request.auth != null;
    }

    // Función auxiliar para verificar si existe el documento del usuario actual en Firestore
    function hasUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Función auxiliar para obtener los datos del usuario actual en Firestore
    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verificar si el usuario autenticado tiene su cuenta activa
    // Por compatibilidad con cuentas existentes, si no tiene 'status', se considera 'active'
    function isActiveUser() {
      return hasUserData() && currentUserData().get('status', 'active') == 'active';
    }

    // Verificar si el usuario es un administrador activo
    function isActiveAdmin() {
      return hasUserData() 
        && currentUserData().get('role', '') == 'admin' 
        && currentUserData().get('status', 'active') == 'active';
    }
    
    // Reglas para la colección de usuarios
    match /users/{userId} {
      // Un usuario autenticado puede leer su propio perfil siempre (incluso si está desactivado, para poder detectar su estado).
      // Para leer perfiles ajenos (catálogo de profesores, alumnos en clase o panel de administración), debe ser un usuario activo.
      allow read: if isSignedIn() && (request.auth.uid == userId || isActiveUser());
      
      // Permitir crear el perfil si está autenticado con el mismo UID y el rol es EXCLUSIVAMENTE 'student' o 'teacher'
      // El estado inicial (si se envía) debe ser 'active'. Se impide estrictamente registrarse como 'admin'.
      allow create: if isSignedIn() 
                    && request.auth.uid == userId 
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ['student', 'teacher']
                    && request.resource.data.get('status', 'active') == 'active';
                    
      // Permitir actualizar perfil bajo dos únicas vías seguras:
      // Vía 1: El propio usuario activo actualiza sus datos personales (su rol y status son INMUTABLES)
      // Vía 2: Un administrador activo modifica EXCLUSIVAMENTE el campo status de otro usuario (no puede desactivarse a sí mismo)
      allow update: if isSignedIn() && (
        // Vía 1: Actualización propia por usuario activo
        (
          isActiveUser()
          && request.auth.uid == userId 
          && request.resource.data.uid == userId
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        )
        ||
        // Vía 2: Activación/Desactivación por un administrador activo
        (
          isActiveAdmin()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'disabled']
        )
      );
                    
      // Prohibir la eliminación de documentos de usuarios desde el cliente en este MVP
      allow delete: if false;

      // Subcolección privada para configuraciones sensibles del profesor (Sala permanente de Google Meet)
      // Acceso estrictamente restringido al propio profesor titular activo (Subbloque 4)
      match /privateSettings/{docId} {
        // Solo el profesor activo titular puede leer su configuración privada
        allow read: if isSignedIn() 
                    && request.auth.uid == userId 
                    && isActiveUser() 
                    && currentUserData().get('role', '') == 'teacher';

        // Solo el profesor activo titular puede escribir/actualizar su configuración de meetConfig
        // Validando el esquema, inmutabilidad de teacherId y formato de permanentMeetUrl
        allow write: if isSignedIn() 
                     && request.auth.uid == userId 
                     && isActiveUser() 
                     && currentUserData().get('role', '') == 'teacher'
                     && docId == 'meetConfig'
                     && request.resource.data.teacherId == userId
                     && request.resource.data.permanentMeetUrl is string
                     && request.resource.data.permanentMeetUrl.size() > 24
                     && request.resource.data.permanentMeetUrl.matches('https://meet\\.google\\.com/.*')
                     && request.resource.data.permanentMeetSpaceName is string;
      }
    }

    // Reglas para la colección de disponibilidad de profesores (teacherAvailability)
    match /teacherAvailability/{availabilityId} {
      // Cualquier usuario autenticado y activo puede consultar horarios disponibles
      allow read: if isActiveUser();

      // Solo un profesor activo puede crear franjas asignándose como teacherId
      allow create: if isActiveUser()
                    && request.resource.data.teacherId == request.auth.uid
                    && currentUserData().get('role', '') == 'teacher'
                    && request.resource.data.status in ['available', 'booked'];

      // Permitir actualización:
      // 1. El propio profesor dueño activo actualiza su franja (teacherId inmutable)
      // 2. Un alumno activo reserva un horario disponible: cambia status a 'booked' y registra lessonId, preservando teacherId, date, startTime y duration
      allow update: if isActiveUser() && (
        (
          resource.data.teacherId == request.auth.uid &&
          request.resource.data.teacherId == request.auth.uid
        )
        ||
        (
          currentUserData().get('role', '') == 'student' &&
          resource.data.status == 'available' &&
          request.resource.data.status == 'booked' &&
          request.resource.data.teacherId == resource.data.teacherId &&
          request.resource.data.date == resource.data.date &&
          request.resource.data.startTime == resource.data.startTime &&
          request.resource.data.duration == resource.data.duration &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lessonId', 'updatedAt'])
        )
      );

      // Solo el profesor dueño activo puede eliminar su franja
      allow delete: if isActiveUser() && resource.data.teacherId == request.auth.uid;
    }

    // Reglas para la colección de clases (lessons)
    match /lessons/{lessonId} {
      // Solo el profesor o el alumno asignado y activos pueden leer la clase
      allow read: if isActiveUser() && (
        resource.data.teacherId == request.auth.uid || 
        resource.data.studentId == request.auth.uid
      );
      
      // Permitir crear clases:
      // 1. Profesor activo crea una clase asignándose como teacherId
      // 2. Alumno activo reserva una clase asignándose como studentId, con status 'scheduled' y hacia un profesor existente y activo
      allow create: if isActiveUser() && (
        (
          request.resource.data.teacherId == request.auth.uid &&
          currentUserData().get('role', '') == 'teacher' &&
          request.resource.data.status in ['scheduled', 'in_progress', 'completed', 'cancelled']
        )
        ||
        (
          currentUserData().get('role', '') == 'student' &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.status == 'scheduled' &&
          exists(/databases/$(database)/documents/users/$(request.resource.data.teacherId)) &&
          get(/databases/$(database)/documents/users/$(request.resource.data.teacherId)).data.get('role', '') == 'teacher'
        )
      );
                    
      // Solo el profesor creador activo puede actualizar o eliminar la clase
      allow update: if isActiveUser() 
                    && resource.data.teacherId == request.auth.uid
                    && request.resource.data.teacherId == request.auth.uid;
                    
      allow delete: if isActiveUser() && resource.data.teacherId == request.auth.uid;

      // Subcolección whiteboard de la clase: acceso exclusivo para el profesor y alumno activos asignados
      match /whiteboard/{docId} {
        allow read, write: if isActiveUser() &&
          exists(/databases/$(database)/documents/lessons/$(lessonId)) && (
            get(/databases/$(database)/documents/lessons/$(lessonId)).data.teacherId == request.auth.uid ||
            get(/databases/$(database)/documents/lessons/$(lessonId)).data.studentId == request.auth.uid
          );
      }
    }

    // Reglas para la colección de horarios recurrentes de profesores (teacherRecurringSlots)
    match /teacherRecurringSlots/{slotId} {
      // Cualquier usuario activo puede consultar horarios recurrentes de profesores
      allow read: if isActiveUser();

      // Solo un profesor activo puede crear reglas de horarios recurrentes asignándose a sí mismo
      allow create: if isActiveUser()
                    && request.resource.data.teacherId == request.auth.uid
                    && currentUserData().get('role', '') == 'teacher'
                    && request.resource.data.dayOfWeek >= 0 && request.resource.data.dayOfWeek <= 6
                    && request.resource.data.duration in [30, 45, 60]
                    && request.resource.data.isActive is bool;

      // Solo el profesor dueño activo puede modificar sus reglas de horarios recurrentes
      allow update: if isActiveUser()
                    && resource.data.teacherId == request.auth.uid
                    && request.resource.data.teacherId == request.auth.uid;

      // Solo el profesor dueño activo puede eliminar sus reglas de horarios recurrentes
      allow delete: if isActiveUser() && resource.data.teacherId == request.auth.uid;
    }

    // Reglas para la colección de excepciones de disponibilidad y vacaciones (teacherScheduleExceptions)
    match /teacherScheduleExceptions/{exceptionId} {
      // Cualquier usuario activo puede consultar las excepciones de profesores (necesario para visualizar y reservar)
      allow read: if isActiveUser();

      // Solo un profesor activo puede crear excepciones asignadas a sí mismo
      allow create: if isActiveUser()
                    && request.resource.data.teacherId == request.auth.uid
                    && currentUserData().get('role', '') == 'teacher'
                    && request.resource.data.type in ['blocked_date', 'blocked_slot', 'vacation']
                    && request.resource.data.startDate <= request.resource.data.endDate;

      // Solo el profesor dueño activo puede modificar sus excepciones
      allow update: if isActiveUser()
                    && resource.data.teacherId == request.auth.uid
                    && request.resource.data.teacherId == request.auth.uid;

      // Solo el profesor dueño activo puede eliminar sus excepciones (restablecer disponibilidad)
      allow delete: if isActiveUser() && resource.data.teacherId == request.auth.uid;
    }
  }
}

