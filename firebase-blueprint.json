{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuario (profesor, alumno o administrador)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "photoURL": { "type": "string" },
        "authProvider": { "type": "string", "enum": ["email", "google"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role", "authProvider"]
    },
    "TeacherAvailability": {
      "title": "TeacherAvailability",
      "description": "Franja horaria disponible configurada por un profesor",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "date": { "type": "string", "description": "Formato YYYY-MM-DD" },
        "startTime": { "type": "string", "description": "Formato HH:mm" },
        "duration": { "type": "number", "enum": [30, 45, 60] },
        "status": { "type": "string", "enum": ["available", "booked"] },
        "lessonId": { "type": "string", "description": "Identificador de la clase reservada" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "date", "startTime", "duration", "status"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Clase de música particular entre profesor y alumno con enlace de Google Meet",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration": { "type": "number", "enum": [30, 45, 60, 90] },
        "status": { "type": "string", "enum": ["scheduled", "in_progress", "completed", "cancelled"] },
        "availabilityId": { "type": "string", "description": "Identificador del horario reservado" },
        "meetUrl": { "type": "string" },
        "meetSpaceName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "teacherId", "studentId", "date", "duration", "status"]
    },
    "WhiteboardState": {
      "title": "WhiteboardState",
      "description": "Estado de la pizarra colaborativa en tiempo real de la clase",
      "type": "object",
      "properties": {
        "strokes": {
          "type": "array",
          "description": "Lista de trazos dibujados en la pizarra"
        },
        "templates": {
          "type": "array",
          "description": "Lista de plantillas musicales (pentagrama, tablatura) añadidas a la pizarra"
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "TeacherRecurringSlot": {
      "title": "TeacherRecurringSlot",
      "description": "Regla semanal de disponibilidad recurrente permanente del profesor",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "dayOfWeek": { "type": "number", "minimum": 0, "maximum": 6 },
        "startTime": { "type": "string", "description": "Formato HH:mm" },
        "endTime": { "type": "string", "description": "Formato HH:mm" },
        "duration": { "type": "number", "enum": [30, 45, 60] },
        "isActive": { "type": "boolean" },
        "originDate": { "type": "string", "description": "Formato YYYY-MM-DD" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "dayOfWeek", "startTime", "endTime", "duration", "isActive", "originDate"]
    },
    "MonthlyBooking": {
      "title": "MonthlyBooking",
      "description": "Abono mensual contratado por un alumno que agrupa las clases de un mes específico",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "month": { "type": "string", "description": "Formato YYYY-MM" },
        "recurringSlotIds": { "type": "array" },
        "weeklyFrequency": { "type": "number", "enum": [1, 2, 3] },
        "lessonIds": { "type": "array" },
        "totalLessons": { "type": "number" },
        "status": { "type": "string", "enum": ["confirmed", "pending_payment", "cancelled", "refunded"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "studentId", "month", "recurringSlotIds", "weeklyFrequency", "lessonIds", "totalLessons", "status"]
    },
    "TeacherSlotLock": {
      "title": "TeacherSlotLock",
      "description": "Cerrojo determinista de exclusividad horaria por profesor y fecha",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "date": { "type": "string", "description": "Formato YYYY-MM-DD" },
        "startTime": { "type": "string", "description": "Formato HH:mm" },
        "endTime": { "type": "string", "description": "Formato HH:mm" },
        "duration": { "type": "number" },
        "bookingType": { "type": "string", "enum": ["monthly", "punctual", "manual"] },
        "bookingId": { "type": "string" },
        "studentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "date", "startTime", "endTime", "bookingType", "bookingId", "studentId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "User",
      "description": "Documentos de usuarios identificados por su UID de Firebase Authentication."
    },
    "/teacherAvailability/{availabilityId}": {
      "entity": "TeacherAvailability",
      "description": "Colección de horarios y franjas de disponibilidad configuradas por los profesores."
    },
    "/teacherRecurringSlots/{recurringSlotId}": {
      "entity": "TeacherRecurringSlot",
      "description": "Colección de horarios semanales recurrentes permanentes configurados por profesores."
    },
    "/lessons/{lessonId}": {
      "entity": "Lesson",
      "description": "Colección de clases de música asignadas entre un profesor y un alumno."
    },
    "/lessons/{lessonId}/whiteboard/{docId}": {
      "entity": "WhiteboardState",
      "description": "Documento de estado de la pizarra en tiempo real de una clase específica."
    },
    "/monthlyBookings/{bookingId}": {
      "entity": "MonthlyBooking",
      "description": "Colección de abonos mensuales que agrupan clases recurrentes de un mes."
    },
    "/teacherSlotLocks/{lockKey}": {
      "entity": "TeacherSlotLock",
      "description": "Colección de cerrojos deterministas de concurrencia por profesor, fecha y hora."
    }
  }
}
